{
  "name": "idempotency-keys",
  "version": "0.1.0",
  "description": "Stripe-style idempotency keys for your own API, in Postgres: retries, crashes and concurrent requests run the work exactly once.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "idempotency",
    "idempotency-key",
    "postgres",
    "stripe",
    "payments",
    "exactly-once",
    "fault-injection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderinho2/idempotency-keys.git"
  },
  "homepage": "https://github.com/coderinho2/idempotency-keys#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.23.2",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
